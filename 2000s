  <!-- Data Interceptor: Filters for 2000-2009 before the chart draws -->
  <script>
      if (typeof decadeData !== 'undefined') {
          decadeData = decadeData.filter(row => {
              const year = row[0].getFullYear();
              return year >= 2000 && year <= 2009;
          });
      }
  </script>
